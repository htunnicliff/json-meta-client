{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>htunnicliff/renovate"],
  "packageRules": [
    {
      "description": "Stay on TypeScript 6: the docs tooling uses its compiler API, which TypeScript 7 doesn't provide. CI checks the types against TypeScript 7 separately.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Testcontainers images in the integration suite",
      "managerFilePatterns": ["/^src/__test__/integration/.+\\.ts$/"],
      "matchStrings": [
        "new GenericContainer\\(\\s*\"(?<depName>[^:@\"]+):(?<currentValue>[^@\"]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\"\\s*\\)"
      ],
      "autoReplaceStringTemplate": "new GenericContainer(\"{{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}\")",
      "datasourceTemplate": "docker"
    }
  ]
}
