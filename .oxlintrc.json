{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "node", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "no-shadow": "off",
    "typescript/consistent-type-definitions": ["error", "interface"]
  },
  "env": {
    "builtin": true
  },
  "options": {
    "typeAware": true
  }
}
