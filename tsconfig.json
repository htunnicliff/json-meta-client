{
  "compilerOptions": {
    "useDefineForClassFields": true,
    "forceConsistentCasingInFileNames": true,

    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment Settings
    "module": "nodenext",
    "paths": {
      "json-meta-client": ["./src/index.ts"],
      "json-meta-client/capabilities": ["./src/capabilities/index.ts"],
      "json-meta-client/capabilities/community": ["./src/capabilities/community/index.ts"]
    },
    "target": "esnext",
    "types": [],
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": true,

    // Other Outputs
    "sourceMap": true,
    "declaration": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src"]
}
