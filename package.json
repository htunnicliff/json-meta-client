{
  "name": "json-meta-client",
  "version": "0.10.0",
  "bugs": {
    "url": "https://github.com/htunnicliff/json-meta-client/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Hunter Tunnicliff",
    "email": "hunter@tunnicliff.co"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/htunnicliff/json-meta-client.git"
  },
  "files": [
    "dist",
    "package.json",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "spelling:check": "cspell .",
    "version": "pnpm run build && changeset version && pnpm install",
    "release": "pnpm run build && changeset publish",
    "prepare": "husky"
  },
  "dependencies": {
    "eventsource-client": "^1.2.0",
    "jmap-rfc-types": "^0.5.0",
    "type-fest": "^5.10.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@types/node": "26.6.4",
    "cspell": "10.3.6",
    "husky": "9.1.7",
    "nock": "14.0.17",
    "oxfmt": "0.72.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "pkg-pr-new": "0.0.90",
    "publint": "0.3.25",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.10.0+sha512.122a7b6ddf9d40268bc0db1a9780899b95e4fa8badfca7bd450615ad8cf7c2659f5f569c20ed7c53886bc7b08d0d50a54f4ad50706847f5682ec6c5048416539"
}
