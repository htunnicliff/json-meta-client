{
  "name": "json-meta-client",
  "version": "0.6.1",
  "bugs": {
    "url": "https://github.com/htunnicliff/json-meta-client/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Hunter Tunnicliff",
    "email": "hunter@tunnicliff.co"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/htunnicliff/json-meta-client.git"
  },
  "files": [
    "dist",
    "package.json",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "spelling:check": "cspell .",
    "version": "pnpm run build && changeset version && pnpm install",
    "publish": "pnpm run build && changeset publish",
    "prepare": "husky"
  },
  "dependencies": {
    "eventsource-client": "^1.2.0",
    "jmap-rfc-types": "^0.5.0",
    "type-fest": "^5.8.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.2",
    "@types/node": "26.1.1",
    "cspell": "10.0.1",
    "husky": "9.1.7",
    "nock": "14.0.17",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "oxlint-tsgolint": "0.24.0",
    "pkg-pr-new": "0.0.88",
    "publint": "0.3.24",
    "tsdown": "0.22.7",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.27.1+sha512.a81d4c21b9b09a4b0aebf90ef5e527d4262bdda322d26082978cb549023ac6d9cafc98b19fffaa5c71db438a65f70224edb78d7311187861ff96480d1cdca23c"
}
