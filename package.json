{
  "name": "json-meta-client",
  "version": "0.11.0",
  "bugs": {
    "url": "https://github.com/htunnicliff/json-meta-client/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Hunter Tunnicliff",
    "email": "hunter@tunnicliff.co"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/htunnicliff/json-meta-client.git"
  },
  "files": [
    "dist",
    "package.json",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "spelling:check": "cspell .",
    "version": "pnpm run build && changeset version && pnpm install",
    "release": "pnpm run build && changeset publish",
    "prepare": "husky",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "eventsource-client": "^1.2.0",
    "jmap-rfc-types": "^0.5.0",
    "type-fest": "^5.10.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@types/node": "26.6.5",
    "cspell": "10.4.0",
    "husky": "9.1.7",
    "nock": "15.0.1",
    "oxfmt": "0.73.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "pkg-pr-new": "0.0.91",
    "publint": "0.3.25",
    "tsdown": "0.23.1",
    "typescript": "6.0.3",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
