{
  "name": "json-meta-client",
  "version": "1.0.1",
  "description": "A better JMAP client",
  "keywords": [
    "api",
    "jmap",
    "json",
    "sdk",
    "typescript"
  ],
  "homepage": "https://json-meta-client.dev",
  "bugs": {
    "url": "https://github.com/htunnicliff/json-meta-client/issues"
  },
  "license": "MPL-2.0",
  "author": {
    "name": "Hunter Tunnicliff",
    "email": "hunter@tunnicliff.co"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/htunnicliff/json-meta-client.git"
  },
  "funding": [
    "https://buymeacoffee.com/htunnicliff"
  ],
  "files": [
    "dist",
    "package.json",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./rfc-types": "./dist/rfc-types.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "types": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "lint": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "spelling:check": "cspell .",
    "version": "pnpm run build && changeset version && pnpm install",
    "release": "pnpm run build && changeset publish",
    "prepare": "husky",
    "docs:banner": "node scripts/generate-readme-banner.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:check": "pnpm build && node scripts/check-docs.mjs",
    "package:check": "pnpm build && node scripts/check-package.mjs",
    "size:table": "node scripts/update-bundle-size.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.8",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "@typescript/vfs": "1.6.6",
    "@valtown/codemirror-ts": "2.3.1",
    "codemirror": "6.0.2",
    "comlink": "4.4.2",
    "cspell": "10.5.2",
    "husky": "9.1.7",
    "nock": "15.0.6",
    "opentype.js": "2.0.0",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "pkg-pr-new": "0.0.94",
    "prettier": "3.10.1",
    "publint": "0.3.25",
    "rolldown": "1.3.3",
    "svgo": "4.1.0",
    "testcontainers": "12.2.2",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vitepress": "2.0.0-alpha.21",
    "vitepress-plugin-group-icons": "1.8.2",
    "vitest": "5.1.1",
    "ws": "8.23.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975"
}
