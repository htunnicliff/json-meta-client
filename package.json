{
  "name": "json-meta-client",
  "version": "0.8.0",
  "bugs": {
    "url": "https://github.com/htunnicliff/json-meta-client/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Hunter Tunnicliff",
    "email": "hunter@tunnicliff.co"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/htunnicliff/json-meta-client.git"
  },
  "files": [
    "dist",
    "package.json",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./capabilities": {
      "types": "./dist/capabilities/index.d.mts",
      "default": "./dist/capabilities/index.mjs"
    },
    "./capabilities/community": {
      "types": "./dist/capabilities/community/index.d.mts",
      "default": "./dist/capabilities/community/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "spelling:check": "cspell .",
    "version": "pnpm run build && changeset version && pnpm install",
    "release": "pnpm run build && changeset publish",
    "prepare": "husky"
  },
  "dependencies": {
    "eventsource-client": "^1.2.0",
    "jmap-rfc-types": "^0.5.0",
    "type-fest": "^5.10.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@types/node": "26.6.3",
    "cspell": "10.3.4",
    "husky": "9.1.7",
    "nock": "14.0.17",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "0.25.0",
    "pkg-pr-new": "0.0.88",
    "publint": "0.3.24",
    "tsdown": "0.22.7",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@12.7.0+sha512.9c56477e360068d6e9dca6a92efb4e46b3dc5a52fcebf3d84d78b9736c0ded589a561621a52f68219a7a39facc63cdc079c3226ef9c9d5f02b79f74e69a807b6"
}
