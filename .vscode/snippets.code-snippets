{
  // Place your json-meta-client workspace snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and
  // description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope
  // is left empty or omitted, the snippet gets applied to all languages. The prefix is what is
  // used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
  // $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders.
  // Placeholders with the same ids are connected.
  // Example:
  // "Print to console": {
  // 	"scope": "javascript,typescript",
  // 	"prefix": "log",
  // 	"body": [
  // 		"console.log('$1');",
  // 		"$2"
  // 	],
  // 	"description": "Log output to console"
  // }
  //
  // You can also restrict snippets to specific files using include/exclude patterns:
  "Contract Namespace": {
    "scope": "typescript",
    "prefix": "cns",
    "body": [
      "export namespace ${1:entity}${2:method} {",
      "  export interface Input extends Method${2:method}.Input<${1:entity}> {}",
      "  export interface Output extends Method${2:method}.Output {}",
      "  export interface Contract {",
      "    input: Input;",
      "    output: Output;",
      "  }",
      "}",
    ],
    "description": "Insert contract namespace",
  },
  "Contract Namespace Dynamic": {
    "scope": "typescript",
    "prefix": "cnsd",
    "body": [
      "export namespace ${1:entity}${2:method} {",
      "  export interface Input extends Method${2:method}.Input<${1:entity}> {}",
      "  export interface Output<Args> extends Method${2:method}.Output<${1:entity}, Args> {}",
      "  export interface Contract {",
      "    input: Input;",
      "    output: Output<this[\"input\"]>;",
      "  }",
      "}",
    ],
    "description": "Insert contract namespace with dynamic output",
  },
}
